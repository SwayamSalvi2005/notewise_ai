// Tells Prisma to generate the JavaScript client library.
// After running "npx prisma generate", you import it like:
//   import { PrismaClient } from "@prisma/client"
generator client {
  provider = "prisma-client-js"
}

// Both come from your .env file.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum DocumentStatus {
  processing // background AI job is still running
  ready      // document is parsed + embedded — ready to chat/quiz
  failed     // something went wrong during parsing
}


// The @map("column_name") tells Prisma the actual column name in the database.

model User {
  // UUID: a universally unique ID like "a3f8c12d-4e5f-..."
  id           String    @id @default(uuid())

  username     String    @unique
  email        String    @unique
  password     String
  profileImage String?   @map("profile_image") // ? means nullable (can be null)

  // Tracks consecutive days of quiz completion 
  streak       Int       @default(0)
  streakDate   DateTime? @map("streak_date") // null = never completed a quiz

  // Auto-managed timestamp
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // They tell Prisma: "a User has many Documents/Quizzes/Chats"
  // Used for: prisma.user.findUnique({ include: { documents: true } })
  documents Document[]
  quizzes   Quiz[]
  chats     Chat[]

  @@map("users") // the actual table name in PostgreSQL
}

//a PDF file the user uploaded.
//   The actual PDF lives in ImageKit (cloud storage).
//   This table stores metadata ABOUT the file.
model Document {
  id           String         @id @default(uuid())

  // FOREIGN KEY: links this document to its owner
  // onDelete: Cascade = if the user is deleted, this document is deleted too
  userId       String         @map("user_id")

  title        String
  fileName     String         @map("file_name")

  // ImageKit file ID — used to DELETE the file from cloud storage later
  fileKey      String?        @map("file_key")

  // Public URL to access/render the PDF in the browser
  fileUrl      String?        @map("file_url")

  // Human-readable size like "2.4 MB"
  fileSize     String         @map("file_size")

 
  // These are stored here as a PostgreSQL text array for summary/quiz generation.
  // The EMBEDDING vectors (768 numbers per chunk) are stored in the chunks table.
  chunks       String[]

  summary      String         @default("")

  uploadDate   DateTime       @default(now()) @map("upload_date")

  // Updated every time the user opens the document
  // Used to sort "recently accessed" documents on the dashboard
  lastAccessed DateTime       @default(now()) @map("last_accessed")

  // Tracks where the background PDF-parsing pipeline is
  status       DocumentStatus @default(processing)

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkEmbeddings Chunk[]  // the embedding chunks (separate table)
  quizzes        Quiz[]
  chats          Chat[]

  @@index([userId]) // index for fast "get all docs for this user" queries
  @@map("documents")
}


model Chunk {
  id         String @id @default(uuid())

  // FOREIGN KEY: which document this chunk came from
  // Cascade: deleting a document auto-deletes all its chunks
  documentId String @map("document_id")

  // The raw text of this chunk (e.g. one paragraph or ~500 words)
  content    String

  // AI CONCEPT: The embedding vector
  // This is a "vector(768)" column managed outside Prisma (via raw SQL).
  // It cannot be queried with normal Prisma syntax — we use prisma.$queryRaw
  // with the <=> operator for similarity search in chatService.js.
  // Marked as Unsupported because pgvector is an extension, not a built-in type.
  embedding  Unsupported("vector(768)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("chunks")
}


model Quiz {
  id          String    @id @default(uuid())

  userId      String    @map("user_id")
  documentId  String    @map("document_id")
  title       String

  // AI CONCEPT: Questions generated by Gemini
  // Stored as JSON array: [{question, options, correctAnswer, explanation, difficulty}]
  // Generated once by geminiService.generateQuiz(), never changed after creation.
  questions   Json

  // Stored after the user submits the quiz
  // JSON array: [{questionIndex, selectedAnswer, isCorrect}]
  // Empty array by default (quiz not yet taken)
  userAnswers Json      @default("[]") @map("user_answers")

  // Score out of 100: (correctCount / totalQuestions) * 100
  score       Int       @default(0)

  // null = quiz not taken yet; set when user submits answers
  completedAt DateTime? @map("completed_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId]) // fast lookups by both user AND document
  @@map("quizzes")
}

 
model Chat {
  id         String   @id @default(uuid())

  userId     String   @map("user_id")
  documentId String   @map("document_id")

  // All messages in this conversation, in order
  // JSON array of: { role: "user"|"ai", content: string, timestamp: string }
  messages   Json     @default("[]")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // ─── Relations ──────────────────────────────────────
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId]) // only ONE chat record per user+document pair
  @@map("chats")
}
